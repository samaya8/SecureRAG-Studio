# ---------------------------------------------------------------------------
# SecureRAG Studio environment template
#
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.
# Every variable here is read on the server only; none is exposed to the
# browser (no NEXT_PUBLIC_ prefix is used for a secret).
# ---------------------------------------------------------------------------

# AI provider: "gemini" (default) or "mock".
# "mock" runs the full pipeline with a deterministic extractive provider and
# no network call. Use it for tests, CI and offline demos only.
AI_PROVIDER=gemini

# Google Gemini credentials. Get a key from https://aistudio.google.com/apikey
# Leave empty to start the app without a provider: the health endpoint will
# report the problem and query requests will fail safely.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Provider request timeout in milliseconds.
PROVIDER_TIMEOUT_MS=15000

# Retrieval trust threshold (0-1). Evidence scoring below this is never sent
# to the model. Owned by platform config and tunable by the evaluation team.
RETRIEVAL_SCORE_THRESHOLD=0.35

# Maximum number of evidence chunks sent to the provider.
MAX_EVIDENCE_CHUNKS=5

# Minimum citation coverage (0-100) an answer must reach to be returned.
# Below this the answer is replaced by a safe Not Found response.
MIN_CITATION_COVERAGE=25
